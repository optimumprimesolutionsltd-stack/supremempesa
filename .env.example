# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
# If something else holds 3000, change this; the dashboard dev proxy follows it,
# but PUBLIC_BASE_URL below must be updated to match or callbacks go astray.
API_PORT=3000
LOG_LEVEL=info

# Postgres and Redis. docker compose provides both.
DATABASE_URL=postgres://mpesa:mpesa@localhost:5432/mpesa_tally
REDIS_URL=redis://localhost:6379

# Bearer token for the dashboard/admin API. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=change-me-to-a-long-random-string

# Public HTTPS origin Safaricom will call. Must be reachable from the internet
# and must be https in production, or URL registration is refused.
PUBLIC_BASE_URL=https://pay.example.co.ke

# Safaricom source IPs. C2B payloads are unsigned, so this filter plus the
# unguessable webhook path are the cheap defences; Daraja verification is the
# real one. Leave empty to disable (development only).
# Confirm current ranges with Safaricom before relying on them in production.
SAFARICOM_IP_ALLOWLIST=196.201.214.0/24,196.201.213.0/24,196.201.212.0/24
TRUST_PROXY=1

# --- Matching and auto-post guardrails ------------------------------------
# Below this confidence, or above this amount, a match is proposed for review
# instead of posted automatically.
AUTO_POST_MIN_CONFIDENCE=0.9
AUTO_POST_MAX_AMOUNT=100000
MATCH_DATE_WINDOW_DAYS=45

# Cross-check a confirmation against Daraja before auto-posting:
#   always | above_threshold | never
VERIFY_BEFORE_AUTOPOST=above_threshold
VERIFY_THRESHOLD_AMOUNT=10000

# --- Daraja ---------------------------------------------------------------
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
# Per-shortcode secrets are resolved by reference (shortcodes.daraja_secret_ref,
# shortcodes.daraja_passkey_ref), e.g. a row holding 'env:DARAJA_DEMO_SECRET'
# reads the variable below. The passkey is what signs an STK Push; without it a
# shortcode can receive payments but cannot request them.
DARAJA_DEMO_KEY=
DARAJA_DEMO_SECRET=
DARAJA_DEMO_PASSKEY=

# --- Operations -----------------------------------------------------------
BACKSTOP_POLL_CRON=*/15 * * * *
# Alert when no callback has arrived for this many minutes. 0 disables.
# Set it to something above your quietest normal gap, not below.
WEBHOOK_SILENCE_ALERT_MINUTES=0
